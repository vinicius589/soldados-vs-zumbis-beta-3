# Os recursos da Beta 4 na raiz ficam no Git comum para entrar em Code > Download ZIP.
# As regras LFS abaixo só se aplicam ao acervo historico preservado em commits antigos.
*.sh text eol=lf
*.command text eol=lf

# Hooks do git precisam de LF para rodar no sh (Windows também).
.githooks/** text eol=lf
.githooks/* text eol=lf
alphas/**/*.png filter=lfs diff=lfs merge=lfs -text
alphas/**/*.jpg filter=lfs diff=lfs merge=lfs -text
alphas/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
alphas/**/*.wav filter=lfs diff=lfs merge=lfs -text
alphas/**/*.ogg filter=lfs diff=lfs merge=lfs -text
alphas/**/*.gif filter=lfs diff=lfs merge=lfs -text
betas/**/*.png filter=lfs diff=lfs merge=lfs -text
betas/**/*.jpg filter=lfs diff=lfs merge=lfs -text
betas/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
betas/**/*.wav filter=lfs diff=lfs merge=lfs -text
betas/**/*.ogg filter=lfs diff=lfs merge=lfs -text
betas/**/*.gif filter=lfs diff=lfs merge=lfs -text
